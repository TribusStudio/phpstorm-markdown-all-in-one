<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dark-scheme colors for Markdown All-in-One.

  Bold and italic need explicit font types: their fallback keys only supply a
  foreground color, so without these entries emphasised text renders in a plain
  face. Everything else is driven by fallback keys (so it follows the user's
  scheme) or by enforced attributes in MarkdownAnnotator.
-->
<list>
  <option baseAttributes="MDAIO_MARKDOWN_TEXT" name="MDAIO_MARKDOWN_BOLD">
    <value>
      <option name="FONT_TYPE" value="1" />
    </value>
  </option>
  <option baseAttributes="MDAIO_MARKDOWN_TEXT" name="MDAIO_MARKDOWN_ITALIC">
    <value>
      <option name="FONT_TYPE" value="2" />
    </value>
  </option>
  <option baseAttributes="MDAIO_MARKDOWN_HEADING_CONTENT" name="MDAIO_MARKDOWN_HEADING_MARKER">
    <value>
      <option name="FONT_TYPE" value="1" />
    </value>
  </option>
</list>
